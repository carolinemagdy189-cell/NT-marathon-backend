{
  "name": "new-testament-marathon-backend",
  "version": "1.0.0",
  "description": "Backend REST API for the New Testament Marathon (Express + MongoDB + JWT, CommonJS)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:readings": "node scripts/seedReadings.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:schedule": "node --test tests/schedule.test.js",
    "test:api": "node --test tests/api.test.js"
  },
"engines": {
  "node": "24.x"
},
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "marathon"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
